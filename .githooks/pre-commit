#!/bin/sh
set -u

if ! command -v bun >/dev/null 2>&1; then
	echo >&2 "Pre-commit checks could not run: bun was not found on PATH."
	echo >&2 "Commit was not blocked."
	exit 0
fi

bun run docs:check:staged || {
	echo >&2 "Markdown wrap advisory failed unexpectedly. Commit was not blocked."
}

bun run skills:docs:check || {
	echo >&2 "Bundled skill references are out of sync."
	echo >&2 "Run: bun run skills:docs:sync"
	exit 1
}

exit 0
